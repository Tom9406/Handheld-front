<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Handheld.ViewModels"
    xmlns:components="clr-namespace:Handheld.Components.Cards"
    x:Class="Handheld.Views.HomePage"
    Title="Inicio">

    <ContentPage.BindingContext>
        <vm:HomeViewModel />
    </ContentPage.BindingContext>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Acerca de" Clicked="OnAboutClicked" Priority="0" Order="Primary" />
        <ToolbarItem Text="Clave" Clicked="OnChangePasswordClicked" Priority="1" Order="Secondary" />
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" Priority="2" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,28" Spacing="18">
            <Border Style="{StaticResource HeroBorderStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Que necesitas hoy?"
                           Style="{StaticResource HeroTitleStyle}" />
                    <Label Text="Explora categorias, solicita servicios y revisa tus gestiones."
                           Style="{StaticResource HeroSubtitleStyle}" />
                </VerticalStackLayout>
            </Border>

            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,*"
                  RowSpacing="12"
                  ColumnSpacing="12">
                <components:CardView Grid.Row="0" Grid.Column="0"
                                     Title="{Binding Categories[0].Title}"
                                     Icon="{Binding Categories[0].Icon}"
                                     Command="{Binding GoToCategoryCommand}"
                                     CommandParameter="{Binding Categories[0]}" />
                <components:CardView Grid.Row="0" Grid.Column="1"
                                     Title="{Binding Categories[1].Title}"
                                     Icon="{Binding Categories[1].Icon}"
                                     Command="{Binding GoToCategoryCommand}"
                                     CommandParameter="{Binding Categories[1]}" />
                <components:CardView Grid.Row="1" Grid.Column="0"
                                     Title="{Binding Categories[2].Title}"
                                     Icon="{Binding Categories[2].Icon}"
                                     Command="{Binding GoToCategoryCommand}"
                                     CommandParameter="{Binding Categories[2]}" />
                <components:CardView Grid.Row="1" Grid.Column="1"
                                     Title="{Binding Categories[3].Title}"
                                     Icon="{Binding Categories[3].Icon}"
                                     Command="{Binding GoToCategoryCommand}"
                                     CommandParameter="{Binding Categories[3]}" />
                <components:CardView Grid.Row="2" Grid.Column="0"
                                     Title="{Binding Categories[4].Title}"
                                     Icon="{Binding Categories[4].Icon}"
                                     Command="{Binding GoToCategoryCommand}"
                                     CommandParameter="{Binding Categories[4]}" />
                <components:CardView Grid.Row="2" Grid.Column="1"
                                     Title="{Binding Categories[5].Title}"
                                     Icon="{Binding Categories[5].Icon}"
                                     Command="{Binding GoToCategoryCommand}"
                                     CommandParameter="{Binding Categories[5]}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
