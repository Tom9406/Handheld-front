<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:Handheld.Components.Bars"
    x:Class="Handheld.Views.ShipmentHeadersPage"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*"
          BackgroundColor="White">

        <!--  CUSTOM BAR -->
        <components:Bar
            Grid.Row="0"
            Title="Shipments"
            MenuCommand="{Binding OpenMenuCommand}" />

        <!--  SEARCH -->
        <Entry
            x:Name="SearchEntry"
            Grid.Row="1"
            Text="{Binding SearchText}"
            ReturnCommand="{Binding SearchCommand}"
            ReturnType="Search"
            Placeholder="Buscar shipment..."
            Margin="4"
            BackgroundColor="White"
            PlaceholderColor="Black"
            TextColor="Black" />

        <!--  RESULT AREA -->
        <Grid Grid.Row="2">

            <!-- LOADING -->
            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!-- NO DATA -->
            <Label
                Text="No hay datos"
                IsVisible="{Binding IsEmpty}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                FontAttributes="Italic"
                TextColor="Black"/>

            <!-- LIST -->
            <CollectionView
                ItemsSource="{Binding Items}"
                IsVisible="{Binding HasData}"
                SelectionMode="Single"
                SelectionChanged="OnSelectionChanged"
                BackgroundColor="White">

                <!-- HEADER -->
                <CollectionView.Header>
                    <Grid BackgroundColor="#E5E7EB"
                          ColumnDefinitions="1.5*,2*,1.5*">

                        <Label Text="Shipment"
                               Padding="8"
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Label Grid.Column="1"
                               Text="Customer"
                               Padding="8"
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Label Grid.Column="2"
                               Text="Status"
                               Padding="8"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="Black"/>
                    </Grid>
                </CollectionView.Header>

                <!-- ITEMS -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8"
                              ColumnDefinitions="1.5*,2*,1.5*">

                            <Label Text="{Binding ShipmentNo}"
                                   TextColor="Black"/>

                            <Label Grid.Column="1"
                                   Text="{Binding CustomerName}"
                                   TextColor="Black"/>

                            <Label Grid.Column="2"
                                   Text="{Binding ShipmentStatus}"
                                   HorizontalTextAlignment="Center"
                                   TextColor="Black"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>
</ContentPage>