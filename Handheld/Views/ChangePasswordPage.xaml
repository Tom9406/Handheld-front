<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Handheld.Views.ChangePasswordPage"
    Title="Cambiar contrasena"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24,28,24,32" Spacing="16">
            <Label Text="Protege tu cuenta"
                   Style="{StaticResource TitleLabelStyle}" />
            <Label Text="Cambia tu contrasena para continuar usando la app."
                   Style="{StaticResource SubtitleLabelStyle}" />

            <Border Style="{StaticResource SurfaceBorderStyle}">
                <VerticalStackLayout Spacing="14">
                    <Entry Placeholder="Contrasena actual"
                           IsPassword="True"
                           Text="{Binding CurrentPassword}" />
                    <Entry Placeholder="Nueva contrasena"
                           IsPassword="True"
                           Text="{Binding NewPassword}" />
                    <Entry Placeholder="Confirmar nueva contrasena"
                           IsPassword="True"
                           Text="{Binding ConfirmPassword}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Actualizar contrasena"
                    Command="{Binding ChangePasswordCommand}" />
            <Button Text="Cancelar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
