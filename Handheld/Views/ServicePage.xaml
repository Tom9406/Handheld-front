<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Handheld.Views.ServicesPage"
             Title="Servicios"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="back_outline.svg"
                     Clicked="OnBackClicked"
                     Priority="0"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="18,16,18,24">
        <VerticalStackLayout Spacing="10">
            <Label Text="Selecciona un servicio"
                   Style="{StaticResource TitleLabelStyle}" />
            <Label Text="Elige el tramite que quieres solicitar y sigue los pasos."
                   Style="{StaticResource SubtitleLabelStyle}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        Margin="0,18,0,0"
                        ItemsSource="{Binding Services}"
                        SelectionMode="Single"
                        SelectionChanged="OnServiceSelected">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SurfaceBorderStyle}"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="6">
                            <Label Grid.Row="0"
                                   Text="{Binding Name}"
                                   Style="{StaticResource SectionTitleStyle}" />
                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding Price, StringFormat='Gs {0:N0}'}"
                                   TextColor="{StaticResource BrandLeaf}"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Description}"
                                   Style="{StaticResource BodyLabelStyle}" />
                            <Label Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding EstimatedTimeText, StringFormat='Tiempo estimado: {0}'}"
                                   Style="{StaticResource CaptionLabelStyle}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
