<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:Handheld.Components.Bars"
    x:Class="Handheld.Components.Bars.Bar">

    <Grid Padding="10" BackgroundColor="{StaticResource BrandBlue}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0"
        Text="{Binding Icon, Source={x:Reference Root}}"
        Clicked="OnLeftClicked"
        BackgroundColor="Transparent"
        TextColor="White"
        FontSize="22"/>

        <!-- TÍTULO -->
        <Label Grid.Column="1"
           Text="{Binding Title, Source={RelativeSource AncestorType={x:Type components:Bar}}}"
           TextColor="White"
           VerticalOptions="Center"
           HorizontalOptions="Center"
           HorizontalTextAlignment="Center"
           FontAttributes="Bold"
           FontSize="16"/>

        <!-- ESPACIO DERECHO (balance) -->
        <BoxView Grid.Column="2" WidthRequest="40" Opacity="0"/>
    </Grid>
</ContentView>